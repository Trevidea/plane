                  "  const cards = pm.response.json().results;",
                  "  const card = cards.find((entry) => entry.id === pm.collectionVariables.get('cardId'));",
                  "  pm.expect(card, 'Card not on this page; choose a fresh card or increase limit').to.exist;",
                  "  pm.expect(card.coaching_card_data).not.to.have.property('recipient_ids');",
                  "  pm.expect(card.coaching_card_data.review).not.to.have.property('viewed_by');",
                  "  pm.expect(card.coaching_card_data.review.recipient_count).to.equal(2);",
                  "  pm.expect(card.coaching_card_data.review.viewed_count).to.equal(0);",
                  "});"
