{
  "info": {
    "_postman_id": "b7600e4a-837d-491c-8934-75fc9e1b1f62",
    "name": "Kanavio - Coaching Card Player Actions",
    "description": "Local/test use only. This collection links two roster players to accounts, records their review acknowledgements, and changes a real card's stage. Create a NEW card with exactly two recipients on a board with Assigned -> Player Reviewed before each run. Set baseUrl, workspaceSlug, projectId, rosterPlayer1Id, rosterPlayer2Id, and cardId in collection variables. Set coachEmail, coachPassword, player1Email, player1Password, player2Email, and player2Password as SECRET variables in a local Postman environment; never export real passwords. Use the same baseUrl host for every request and keep Postman's cookie jar enabled. Run requests in numbered order. Sign-in requests have redirects disabled because the API redirects to the web app. A linked player must be an active workspace member, but need not be a project member. This verifies the API acknowledgement, not video playback. The three-day timeout is covered by automated tests, not this collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://plane.local:8000" },
    { "key": "workspaceSlug", "value": "" },
    { "key": "projectId", "value": "" },
    { "key": "rosterPlayer1Id", "value": "" },
    { "key": "rosterPlayer2Id", "value": "" },
    { "key": "cardId", "value": "" },
    { "key": "csrfToken", "value": "" },
    { "key": "player1UserId", "value": "" },
    { "key": "player2UserId", "value": "" },
    { "key": "assignedStageId", "value": "" },
    { "key": "reviewedStageId", "value": "" }
  ],
  "item": [
    {
      "name": "01 - Identify player accounts",
      "item": [
        {
          "name": "01.1 - Get CSRF token for player 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CSRF token received', function () {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "  const token = pm.response.json().csrf_token;",
                  "  pm.expect(token).to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('csrfToken', token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/get-csrf-token/"
          }
        },
        {
          "name": "01.2 - Sign in player 1",
          "protocolProfileBehavior": { "followRedirects": false },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Sign-in redirects after credential check', function () {",
                  "  pm.expect([302, 303]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              { "key": "X-CSRFToken", "value": "{{csrfToken}}" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "email", "value": "{{player1Email}}", "type": "text" },
                {
                  "key": "password",
                  "value": "{{player1Password}}",
                  "type": "text"
                }
              ]
            },
            "url": "{{baseUrl}}/auth/sign-in/"
          }
        },
        {
          "name": "01.3 - Confirm player 1 account",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Player 1 session is active', function () {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "  const user = pm.response.json();",
                  "  pm.expect(user.email.toLowerCase()).to.equal(pm.variables.get('player1Email').toLowerCase());",
                  "  pm.collectionVariables.set('player1UserId', user.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Cache-Control", "value": "no-cache" }],
            "url": "{{baseUrl}}/api/users/me/"
          }
        },
        {
