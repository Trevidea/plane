                  "pm.test('System stage transition is recorded', function () {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "  const expected = pm.collectionVariables.get('reviewedStageId');",
                  "  pm.expect(pm.response.json().some((entry) => entry.to_stage_id === expected && entry.changed_by_id === null)).to.equal(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/workspaces/{{workspaceSlug}}/projects/{{projectId}}/coaching-cards/{{cardId}}/stage-history/"
          }
        }
      ]
    }
  ]
}
