                  "pm.test('Board supports automatic review transition', function () {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "  const stages = pm.response.json().stages;",
                  "  const assigned = stages[1];",
                  "  const reviewed = stages[2];",
