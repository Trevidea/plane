(plane_proxy) {
	@private_video_upload path /api/player/workspaces/*/projects/*/coaching-cards/*/private-thread/attachments/ /api/workspaces/*/projects/*/coaching-cards/*/private-threads/*/attachments/
	@other_requests not path /api/player/workspaces/*/projects/*/coaching-cards/*/private-thread/attachments/ /api/workspaces/*/projects/*/coaching-cards/*/private-threads/*/attachments/
	request_body @private_video_upload {
		max_size 1073741824
	}
	request_body @other_requests {
		max_size {$FILE_SIZE_LIMIT}
	}

	reverse_proxy /spaces/* space:3000

	reverse_proxy /god-mode/* admin:3000
	
	reverse_proxy /live/* live:3000

	reverse_proxy /api/* api:8000

	reverse_proxy /auth/* api:8000

	reverse_proxy /{$BUCKET_NAME}/* plane-minio:9000

	reverse_proxy /* web:3000
}

{
	{$CERT_EMAIL}
	acme_ca {$CERT_ACME_CA:https://acme-v02.api.letsencrypt.org/directory} 
	{$CERT_ACME_DNS}
	servers {
		max_header_size 25MB
		client_ip_headers X-Forwarded-For X-Real-IP
		trusted_proxies static {$TRUSTED_PROXIES:0.0.0.0/0}
	}
}

{$SITE_ADDRESS} {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request delete
				resp_headers delete
				user_id delete
			}
		}
	}
	log_append source caddy-native-v1
	@diagnostic_request header_regexp diagnostic_request X-Request-ID "^[A-Za-z0-9_.:-]{1,128}$"
	@diagnostic_trace header_regexp diagnostic_trace X-Trace-ID "^[A-Za-z0-9_.:-]{1,128}$"
	log_append @diagnostic_request request_id {http.request.header.X-Request-ID}
	log_append @diagnostic_trace trace_id {http.request.header.X-Trace-ID}
	import plane_proxy
}
